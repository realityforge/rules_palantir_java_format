load("@rules_java//java:defs.bzl", "java_library")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

java_library(
    name = "smoke",
    srcs = ["src/example/Smoke.java"],
    deps = ["@rules_palantir_java_format_smoke_maven//:com_google_guava_guava"],
)

java_format_check(
    name = "format_check",
    remediation = "bazel run @rules_palantir_java_format//:java_format -- --root=src",
    targets = [":smoke"],
)

filegroup(
    name = "fixtures",
    srcs = ["fixtures/example/Fixture.java"],
)

java_format_check(
    name = "fixture_format_check",
    remediation = "bazel run @rules_palantir_java_format//:java_format -- --root=fixtures",
    targets = [":fixtures"],
)

genrule(
    name = "generated_source",
    outs = ["Generated.java"],
    cmd = "printf 'class Generated{}' > $@",
)

genrule(
    name = "source_bundle",
    srcs = [
        "resources/example/Resource.java",
        "resources/not-java.txt",
        ":generated_source",
        "@external_sources//:External.java",
    ],
    outs = ["sources.txt"],
    cmd = "cat $(SRCS) > $@",
)

java_format_check(
    name = "source_format_check",
    remediation = "bazel run @rules_palantir_java_format//:java_format -- --root=resources",
    targets = [
        ":source_bundle",
        "@external_sources//:sources",
    ],
)
